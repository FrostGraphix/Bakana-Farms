# Copy to .env.local and fill in. Never commit real values.
# .env.local is git-ignored.

# ---- Database (system of record: orders, customers, inventory, payments) ----
DATABASE_URL="postgresql://user:password@host:5432/bakana"

# ---- Sanity (editorial content only, never commerce data) ----
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
SANITY_API_READ_TOKEN=""
# Server-side only. Never expose a write token to the browser.
SANITY_API_WRITE_TOKEN=""
SANITY_REVALIDATE_SECRET=""

# ---- Paystack ----
# Nigeria is outside Stripe's supported countries and appears only in its
# "extended network" via Paystack, so Paystack carries both NGN and USD here.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""
PAYSTACK_WEBHOOK_SECRET=""

# ---- Resend (transactional email) ----
RESEND_API_KEY=""
RESEND_FROM_EMAIL="orders@bakanafarms.com"
# Free tier is capped at 100 sends/day. Alarm below that so an order
# confirmation never silently fails. See roadmap 5.6.
RESEND_DAILY_LIMIT="100"
RESEND_DAILY_ALARM_THRESHOLD="80"

# ---- Auth ----
AUTH_SECRET=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Scheduled maintenance ----
# Shared bearer token for the protected maintenance endpoint.
CRON_SECRET=""

# ---- FX ----
# USD display is derived from a single named source, cached, and stamped onto
# the order at the moment of charge. Never display a rate the gateway will not
# honour. See roadmap 5.2.
FX_RATE_SOURCE_URL=""
FX_RATE_REFRESH_MINUTES="360"

# ---- AI shopping guide ----
AI_GATEWAY_API_KEY=""
AI_MODEL_ID="openai/gpt-6-astra"

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PROJECT_ID=""
SUPABASE_JWT_SECRET=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
